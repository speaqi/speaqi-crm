{
  "id": "0xqpUI1Kr7z0UJg2",
  "name": "SPEAQI Automation Error Handler",
  "nodes": [
    {
      "id": "automation_error_trigger",
      "name": "Automation Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [260, 260],
      "parameters": {}
    },
    {
      "id": "send_error_email",
      "name": "Send Error Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [520, 260],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_BASE_URL + '/api/automation/error-alert' }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-automation-secret", "value": "={{ $env.AUTOMATION_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"workflow\":{{ JSON.stringify($json.workflow.name) }},\"execution_id\":{{ JSON.stringify($json.execution.id) }},\"node\":{{ JSON.stringify($json.execution.lastNodeExecuted) }},\"message\":{{ JSON.stringify($json.execution.error.message) }},\"timestamp\":{{ JSON.stringify($now) }},\"url\":{{ JSON.stringify($json.execution.url || '') }}}"
      }
    }
  ],
  "connections": {
    "Automation Error": { "main": [[{ "node": "Send Error Email", "type": "main", "index": 0 }]] }
  },
  "settings": { "timezone": "Europe/Rome", "executionOrder": "v1" },
  "active": false
}
