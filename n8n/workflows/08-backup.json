{
  "id": "BEaj5iJvtqhuarJp",
 "name": "SPEAQI Daily Backup",
 "nodes": [
  {
   "id": "cron_backup",
   "name": "Every Night",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    260,
    260
   ],
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 3 * * *"
      }
     ]
    }
   }
  },
  {
   "id": "call_backup_api",
   "name": "Run Database Backup",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4,
   "position": [
    520,
    260
   ],
   "parameters": {
    "method": "POST",
    "url": "={{ $env.APP_BASE_URL + '/api/automation/backup' }}",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "x-automation-secret",
       "value": "={{ $env.AUTOMATION_SECRET }}"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={\"keep\":30}",
    "options": {
     "timeout": 300000
    }
   }
  }
 ],
 "connections": {
  "Every Night": {
   "main": [
    [
     {
      "node": "Run Database Backup",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "errorWorkflow": "0xqpUI1Kr7z0UJg2",
  "timezone": "Europe/Rome",
  "executionOrder": "v1"
 },
 "active": false
}
