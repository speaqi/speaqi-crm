# Segreto di firma dell'endpoint /api/integrations/stripe/webhook (abbonamenti annuali).
# In locale lo stampa `stripe listen --forward-to localhost:3000/api/integrations/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=whsec_your_endpoint_secret
RESEND_API_KEY=re_your_api_key_here
# Mittente (dominio verificato in Resend), es: CRM <notifiche@tuodominio.it>
#RESEND_FROM=CRM <crm@speaqi.it>
GOOGLE_CLIENT_ID=google_client_id_here
GOOGLE_CLIENT_SECRET=google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret
OPENAI_API_KEY=sk_replace_me
OPENAI_MODEL=gpt-5-mini
AUTOMATION_SECRET=replace_me
SPEAQI_WEBHOOK_SECRET=replace_me
# Dedicated HMAC secret for opaque Wine Project campaign links. Defaults to
# SPEAQI_WEBHOOK_SECRET when omitted, so existing deployments keep working.
WINE_PROJECT_LINK_SECRET=
# Same value as SCRAPING_DEMO_ACCESS_TOKEN / NEXT_PUBLIC_SCRAPING_DEMO_ACCESS_TOKEN
# on the speaqi.com API/web app — required for the /api/wine-project/campaign-link
# redirect to unlock the /demo/wine-project "Accesso Riservato" gate. Not an
# application secret: it is intentionally exposed in shared demo links.
WINE_PROJECT_DEMO_ACCESS_TOKEN=
# Email automatica alla cantina quando la demo Wine e pronta (link alla demo).
# Attiva di default: metterla a false lascia solo la notifica WhatsApp.
WINE_DEMO_EMAIL_ENABLED=true
REMINDER_EMAIL=ops@speaqi.it
ACUMBAMAIL_WEBHOOK_USER_ID=
ACUMBAMAIL_WEBHOOK_TOKEN=
ACUMBAMAIL_AUTH_TOKEN=
# Coda verso Acumbamail: distanza minima fra due chiamate allo stesso endpoint
# (il tetto documentato e 10/min) e numero massimo di tentativi su un 429.
# I default (6500 ms, 4 tentativi) vanno bene: si toccano solo se Acumbamail
# cambia policy.
ACUMBAMAIL_MIN_INTERVAL_MS=6500
ACUMBAMAIL_MAX_ATTEMPTS=4
ACUMBAMAIL_TRANSACTIONAL_WEBHOOK_URL=
# Optional emergency kill switch. Campaign status + legal approval live in CRM.
# Set explicitly to false only to disable all commercial sends at runtime.
COMMERCIAL_OUTREACH_SEND_ENABLED=true
ACUMBAMAIL_DEFAULT_SOURCE=vinitaly
ACUMBAMAIL_DEFAULT_CONTACT_SCOPE=holding
ACUMBAMAIL_CREATE_EVENTS=clicks
ACUMBAMAIL_DEFAULT_CATEGORY=
ACUMBAMAIL_DEFAULT_RESPONSIBLE=
ACUMBAMAIL_DEFAULT_ASSIGNED_AGENT=
ACUMBAMAIL_DEFAULT_LIST_NAME=
ACUMBAMAIL_DEFAULT_EVENT_TAG=
ACUMBAMAIL_ROUTE_WMDEVENT=u=212e3b5a-f099-4b40-9ace-b6c25f1db562&s=crm&r=PierPaolo%20Izzo&e=opens&l=WMDEVENT

# --- Notifiche WhatsApp (gateway OpenWA self-hosted) ---------------------------
# Vedi docs/WHATSAPP-OPENWA.md. Numero DEDICATO, mai quello personale: non e
# l'API ufficiale Meta e un numero segnalato viene bloccato da WhatsApp.
# Qui restano solo le credenziali del gateway: numero destinatario, interruttore
# e scelta degli eventi si impostano da /impostazioni/whatsapp.
OPENWA_BASE_URL=
OPENWA_API_KEY=
# UUID della sessione, non il suo nome: lo restituisce POST/GET /api/sessions.
OPENWA_SESSION_ID=
# Facoltativi. Valgono solo finche non si salva la configurazione nel CRM:
# WHATSAPP_NOTIFY_TO e il numero di partenza, WHATSAPP_NOTIFY_ENABLED=false e il
# freno di emergenza che spegne tutto anche a interruttore acceso.
WHATSAPP_NOTIFY_TO=
WHATSAPP_NOTIFY_ENABLED=

# --- Bot Telegram: note vocali che diventano attivita del To Do ----------------
# Vedi docs/TELEGRAM-TODO.md. Il bot si crea con @BotFather e restituisce il
# token. E un canale in INGRESSO: senza TELEGRAM_ALLOWED_CHAT_IDS non accetta
# niente da nessuno, perche un bot risponde a chiunque ne conosca il nome.
TELEGRAM_BOT_TOKEN=
# Stringa lunga a caso: viaggia nell'header di ogni consegna e dimostra che la
# chiamata arriva davvero da Telegram.
TELEGRAM_WEBHOOK_SECRET=
# Elenco separato da virgole delle chat autorizzate a scrivere nel CRM.
# Il proprio chat id lo dice @userinfobot.
TELEGRAM_ALLOWED_CHAT_IDS=
# Workspace su cui scrivere. Senza, vale AUTOMATION_WORKSPACE_USER_ID.
TELEGRAM_WORKSPACE_USER_ID=
